# Copie para .env (ou defina como variáveis de ambiente de verdade em
# produção) e preencha com os valores reais do ambiente.

DB_URL=jdbc:postgresql://localhost:5432/metas
DB_USER=metas
DB_PASSWORD=metas

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=troque-este-segredo-por-um-valor-forte-e-aleatorio-em-producao
JWT_EXPIRATION_MINUTES=480
JWT_ISSUER=metas-backend

METAS_ANO_REALIZADO=2026
METAS_ANO_ORCAMENTO=2027
METAS_MES_CORTE_REAL=7
